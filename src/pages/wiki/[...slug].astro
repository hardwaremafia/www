---
import { getWikiEntries } from "@/content/wiki";
import WikiPageLayout from "@/layouts/WikiPageLayout.astro";
import { render } from "astro:content";

export async function getStaticPaths() {
    const wikiEntries = await getWikiEntries();
    return wikiEntries
        .filter(({ data }) => (data.goto ? false : true))
        .map((entry) => ({
            params: { slug: entry.id },
            props: { entry },
        }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
console.log("entry", entry);
---

<WikiPageLayout
    sourcePath={`src/content/wiki/${entry.id}.md`}
    frontmatter={{ ...entry.data }}
>
    <Content />
</WikiPageLayout>
